# Backend-container env. Copy to backend.env on the VPS and fill in.
# NEVER commit the real backend.env.

PORT=3001

# Stripe TEST keys for first deploy. Switch to live keys when ready.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# MySQL — service name `mysql` resolves inside the cveditor docker network.
DB_HOST=mysql
DB_PORT=3306
DB_USER=cveditor
DB_PASSWORD=must_match_compose_MYSQL_PASSWORD
DB_NAME=cv_builder_db

TOKEN_SECRET=replace_with_a_long_random_string

# Comma-separated list of browser origins allowed via CORS.
# Include localhost during dev so you can test the prod API from a local frontend.
FRONTEND_ORIGIN=https://www.icover.org.uk,http://localhost:5173

# Hostinger Titan Email SMTP (post-purchase receipt email).
# Note: this is Titan, NOT smtp.hostinger.com — Hostinger sells both, with
# different SMTP servers. Mailbox login URL: https://hostinger.titan.email/login/
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=cvedit@razorflip.com
SMTP_PASSWORD=replace_me
SMTP_FROM=cvedit@razorflip.com
SMTP_FROM_NAME=iCover CV Builder
