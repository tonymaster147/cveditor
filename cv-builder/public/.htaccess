# iCover CV builder — WPX static SPA config
# Lives at the document root of cv-editor.icover.org.uk.

RewriteEngine On

# 1) SPA fallback: serve index.html for any path that doesn't match a real
#    file or directory. Lets React Router routes like /edit/:id, /dashboard,
#    /verify-email survive a hard refresh.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# 2) Caching. Hashed assets (Vite renames JS/CSS/images per build) get the
#    longest possible cache. index.html stays fresh so users pick up new
#    bundle hashes as soon as we redeploy.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # index.html (and other html) should never be cached aggressively.
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  # Vite output filenames contain an 8-char hash — safe to cache forever.
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Compress text resources at the origin (mostly free on WPX).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
