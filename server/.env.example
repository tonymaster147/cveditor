# Copy to .env and fill in real values. Never commit .env.

PORT=3001

# Stripe — get from https://dashboard.stripe.com/test/apikeys (TEST mode only here)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# MySQL (XAMPP defaults: root / blank password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cv_builder_db

# Used to sign download tokens. Generate a random 64-char string.
TOKEN_SECRET=replace_with_a_long_random_string

# Where the frontend is served from (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
